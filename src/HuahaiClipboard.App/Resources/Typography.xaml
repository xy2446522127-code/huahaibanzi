<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HuahaiBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource HuahaiTextPrimaryBrush}" />
    </Style>
    <Style x:Key="HuahaiSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource HuahaiTextSecondaryBrush}" />
    </Style>
</ResourceDictionary>
