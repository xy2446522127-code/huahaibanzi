<Window
    x:Class="HuahaiClipboard.App.Presentation.Windows.CursorPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="花海剪贴板">
    <Grid x:Name="RootGrid" Background="#150D18" KeyDown="RootGrid_KeyDown">
        <Border x:Name="GlassBorder" Margin="8" Padding="1" BorderThickness="1" CornerRadius="26"
                BorderBrush="{StaticResource HuahaiFocusBrush}" Background="{StaticResource HuahaiGlassBrush}">
            <Grid>
                <Canvas x:Name="PetalCanvas" IsHitTestVisible="False" />
                <Grid x:Name="MainPane" Padding="20,18,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                            <TextBlock Text="花海" FontFamily="KaiTi" FontSize="25" FontWeight="SemiBold"
                                       Foreground="{StaticResource HuahaiAccentBrush}" />
                            <TextBlock Text="剪贴板" FontFamily="Microsoft YaHei UI" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource HuahaiTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="最近 7 天 · 12 条" Margin="0,0,12,0"
                                   Style="{StaticResource HuahaiSecondaryTextStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="SettingsButton" Style="{StaticResource HuahaiIconButtonStyle}"
                                    Click="SettingsButton_Click" ToolTipService.ToolTip="设置"
                                    AutomationProperties.Name="打开设置">
                                <FontIcon Glyph="&#xE713;" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="CloseButton_Click"
                                    ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭面板">
                                <FontIcon Glyph="&#xE711;" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,9" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="搜索文本、链接、图片或文件"
                                 TextChanged="SearchBox_TextChanged" Padding="12,0"
                                 VerticalContentAlignment="Center" />
                        <Border Grid.Column="1" Margin="8,0,0,0" Width="40" Height="40" CornerRadius="10"
                                Background="#663C1D50" BorderBrush="#779E5C99" BorderThickness="1">
                            <FontIcon Glyph="&#xE721;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" Margin="0,0,0,10">
                        <Button Tag="All" Content="全部" Click="FilterButton_Click" IsTabStop="False" />
                        <Button Tag="Text" Content="文本" Click="FilterButton_Click" IsTabStop="False" />
                        <Button Tag="Link" Content="链接" Click="FilterButton_Click" IsTabStop="False" />
                        <Button Tag="Image" Content="图片" Click="FilterButton_Click" IsTabStop="False" />
                        <Button Tag="File" Content="文件" Click="FilterButton_Click" IsTabStop="False" />
                        <Button Tag="Favorites" Content="收藏" Click="FilterButton_Click" IsTabStop="False" />
                    </StackPanel>

                    <InfoBar x:Name="RecoveryInfoBar" Grid.Row="3" IsOpen="False" Severity="Warning"
                             IsClosable="True" Margin="0,0,0,8" />

                    <ListView x:Name="RecordList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="RecordList_ItemClick" KeyDown="RecordList_KeyDown"
                              ItemContainerStyle="{StaticResource HuahaiRecordRowStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Height="52" Padding="10,5" CornerRadius="8"
                                        Background="#88351C42" BorderBrush="#446B426E" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#664F2A59"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="✦" FontSize="14" Foreground="{StaticResource HuahaiAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrimaryText}" Style="{StaticResource HuahaiBodyTextStyle}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SecondaryText}" Style="{StaticResource HuahaiSecondaryTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                            <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="Favorite_Click"
                                                    ToolTipService.ToolTip="收藏" AutomationProperties.Name="切换收藏">
                                                <FontIcon Glyph="&#xE734;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="Pin_Click"
                                                    ToolTipService.ToolTip="置顶" AutomationProperties.Name="切换置顶">
                                                <FontIcon Glyph="&#xE718;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="Delete_Click"
                                                    ToolTipService.ToolTip="删除" AutomationProperties.Name="删除记录">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,9,2,0">
                        <TextBlock Text="单击复制" Style="{StaticResource HuahaiSecondaryTextStyle}" />
                        <TextBlock Text="双击粘贴 · Enter" Style="{StaticResource HuahaiSecondaryTextStyle}" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SettingsPane" Visibility="Collapsed" Background="#E6201028" Padding="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="BackFromSettings_Click"
                                ToolTipService.ToolTip="返回面板" AutomationProperties.Name="返回面板">
                            <FontIcon Glyph="&#xE72B;" FontSize="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="外观与动效" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock x:Name="SaveStatusText" Grid.Column="2" Style="{StaticResource HuahaiSecondaryTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel Spacing="14">
                            <TextBlock Text="五套皮肤" FontSize="13" FontWeight="SemiBold" />
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Button Tag="rose-purple" Click="ThemeButton_Click" Margin="0,0,6,6" Padding="8" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="22" Height="22" Fill="#E9A6D1" /><TextBlock Text="玫瑰紫" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Grid.Column="1" Tag="cobalt-blue" Click="ThemeButton_Click" Margin="6,0,0,6" Padding="8" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="22" Height="22" Fill="#77B5FF" /><TextBlock Text="钴蓝" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Grid.Row="1" Tag="emerald-cyan" Click="ThemeButton_Click" Margin="0,0,6,6" Padding="8" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="22" Height="22" Fill="#65DEC8" /><TextBlock Text="翡翠青" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Tag="amber-orange" Click="ThemeButton_Click" Margin="6,0,0,6" Padding="8" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="22" Height="22" Fill="#FFC26D" /><TextBlock Text="琥珀橙" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Grid.Row="2" Tag="aurora-cyan-purple" Click="ThemeButton_Click" Margin="0,0,6,6" Padding="8" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="22" Height="22" Fill="#7FE8E0" /><TextBlock Text="极光青紫" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="#33FFFFFF" />
                            <TextBlock Text="液态玻璃" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="透明度" VerticalAlignment="Center" />
                                <Slider x:Name="OpacitySlider" Minimum="0.65" Maximum="0.96" Value="0.86"
                                        Width="160" HorizontalAlignment="Right" ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="花瓣背景" VerticalAlignment="Center" />
                                <CheckBox x:Name="PetalCheckBox" IsChecked="True" HorizontalAlignment="Right"
                                          Checked="PetalCheckBox_Changed" Unchecked="PetalCheckBox_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="减少动态效果" VerticalAlignment="Center" />
                                <CheckBox x:Name="ReduceMotionCheckBox" HorizontalAlignment="Right"
                                          Checked="ReduceMotionCheckBox_Changed" Unchecked="ReduceMotionCheckBox_Changed" />
                            </StackPanel>
                            <TextBlock Text="修改会即时预览并保存在本机。真实剪贴板接入将在预览确认后启用。"
                                       Style="{StaticResource HuahaiSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
