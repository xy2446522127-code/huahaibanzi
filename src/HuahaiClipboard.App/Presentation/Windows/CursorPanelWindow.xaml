<Window
    x:Class="HuahaiClipboard.App.Presentation.Windows.CursorPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="花海剪贴板">
    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark" KeyDown="RootGrid_KeyDown">
        <Grid.Resources>
            <Storyboard x:Name="LiquidFlowStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="PrimaryReflectionTransform"
                                 Storyboard.TargetProperty="TranslateX"
                                 From="-170" To="130" Duration="0:0:6" />
                <DoubleAnimation Storyboard.TargetName="SecondaryReflectionTransform"
                                 Storyboard.TargetProperty="TranslateX"
                                 From="150" To="-100" Duration="0:0:8" />
                <DoubleAnimation Storyboard.TargetName="SurfaceHighlightTransform"
                                 Storyboard.TargetProperty="TranslateX"
                                 From="-150" To="130" Duration="0:0:5.4" />
            </Storyboard>
        </Grid.Resources>

        <Border x:Name="GlassBorder" CornerRadius="29"
                Background="{StaticResource HuahaiGlassBrush}">
            <Grid>
                <Grid IsHitTestVisible="False">
                    <Border Width="620" Height="132" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="-130,-28,0,0" Opacity="0.64" CornerRadius="66">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00D57FBC" Offset="0" />
                                <GradientStop x:Name="PrimaryReflectionStop" Color="#C2D57FBC" Offset="0.46" />
                                <GradientStop Color="#759C55B9" Offset="0.67" />
                                <GradientStop Color="#00D57FBC" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="PrimaryReflectionTransform" Rotation="24" TranslateX="-170" />
                        </Border.RenderTransform>
                    </Border>
                    <Border Width="520" Height="112" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-125,-34" Opacity="0.42" CornerRadius="56">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#008F5BAA" Offset="0" />
                                <GradientStop x:Name="SecondaryReflectionStop" Color="#A78F5BAA" Offset="0.5" />
                                <GradientStop Color="#00C785B7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="SecondaryReflectionTransform" Rotation="-18" TranslateX="150" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <Canvas x:Name="PetalCanvas" IsHitTestVisible="False" />

                <Grid x:Name="MainPane" Padding="18,17,18,14" Background="#77200E25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="6" Width="570" Height="96" Margin="-145,55,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.42"
                            IsHitTestVisible="False" CornerRadius="48">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00BC7CAF" Offset="0" />
                                <GradientStop x:Name="SurfaceHighlightStop" Color="#B5BC7CAF" Offset="0.5" />
                                <GradientStop Color="#5C9252A8" Offset="0.68" />
                                <GradientStop Color="#00BC7CAF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="SurfaceHighlightTransform" Rotation="19" TranslateX="-150" />
                        </Border.RenderTransform>
                    </Border>

                    <Grid x:Name="PanelDragRegion" Grid.Row="0" Height="40" PointerPressed="DragRegion_PointerPressed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="花海" FontFamily="KaiTi" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource HuahaiAccentBrush}" />
                            <TextBlock Text="剪贴板" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource HuahaiTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="HistorySummary" Grid.Column="1" Text="最近 7 天 · 0 条" Margin="0,0,10,0"
                                   Style="{StaticResource HuahaiSecondaryTextStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="SettingsButton" Style="{StaticResource HuahaiIconButtonStyle}"
                                    Click="SettingsButton_Click" ToolTipService.ToolTip="设置"
                                    AutomationProperties.Name="打开设置">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="CloseButton_Click"
                                    ToolTipService.ToolTip="隐藏" AutomationProperties.Name="隐藏面板">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,11,0,10" Height="40">
                        <TextBox x:Name="SearchBox" PlaceholderText="搜索文本、链接、图片或文件"
                                 TextChanged="SearchBox_TextChanged" Padding="38,0,12,0"
                                 Foreground="{StaticResource HuahaiTextPrimaryBrush}"
                                 Background="#71301838" BorderBrush="#78C58AB6" BorderThickness="1"
                                 CornerRadius="11" VerticalContentAlignment="Center" />
                        <FontIcon Glyph="&#xE721;" FontSize="15" Margin="13,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Foreground="{StaticResource HuahaiTextSecondaryBrush}" IsHitTestVisible="False" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                                  Margin="0,0,0,8">
                        <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="6">
                            <ToggleButton Tag="All" Content="全部" IsChecked="True" Click="FilterButton_Click"
                                          Style="{StaticResource HuahaiFilterToggleStyle}" />
                            <ToggleButton Tag="Text" Content="文本" Click="FilterButton_Click"
                                          Style="{StaticResource HuahaiFilterToggleStyle}" />
                            <ToggleButton Tag="Link" Content="链接" Click="FilterButton_Click"
                                          Style="{StaticResource HuahaiFilterToggleStyle}" />
                            <ToggleButton Tag="Image" Content="图片" Click="FilterButton_Click"
                                          Style="{StaticResource HuahaiFilterToggleStyle}" />
                            <ToggleButton Tag="File" Content="文件" Click="FilterButton_Click"
                                          Style="{StaticResource HuahaiFilterToggleStyle}" />
                            <ToggleButton Tag="Favorites" Content="收藏" Click="FilterButton_Click"
                                          Style="{StaticResource HuahaiFilterToggleStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <InfoBar x:Name="RecoveryInfoBar" Grid.Row="3" IsOpen="False" Severity="Warning"
                             IsClosable="True" Margin="0,0,0,7" />

                    <ListView x:Name="RecordList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="RecordList_ItemClick" KeyDown="RecordList_KeyDown"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource HuahaiRecordRowStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RecordCard" Height="58" CornerRadius="14" Clip="{x:Null}"
                                        DoubleTapped="RecordRow_DoubleTapped"
                                        Background="{StaticResource HuahaiRowSurfaceBrush}"
                                        BorderBrush="#5FC991BB" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <CompositeTransform />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Ellipse x:Name="ClickRipple" Width="20" Height="20" Opacity="0"
                                                 IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{StaticResource HuahaiAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform ScaleX="0" ScaleY="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Grid Padding="10,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="31" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="RecordTypeIcon" Width="28" Height="28" CornerRadius="9"
                                                    Background="#754F2A59" VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <CompositeTransform />
                                                </Border.RenderTransform>
                                                <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource HuahaiAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" MinWidth="0" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrimaryText}" Style="{StaticResource HuahaiBodyTextStyle}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SecondaryText}" Style="{StaticResource HuahaiSecondaryTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <ToggleButton Style="{StaticResource HuahaiActionToggleStyle}"
                                                              IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                                              Click="Favorite_Click" ToolTipService.ToolTip="收藏"
                                                              AutomationProperties.Name="切换收藏">
                                                    <FontIcon Glyph="&#xE734;" FontSize="13" />
                                                </ToggleButton>
                                                <ToggleButton Style="{StaticResource HuahaiActionToggleStyle}"
                                                              IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                              Click="Pin_Click" ToolTipService.ToolTip="置顶"
                                                              AutomationProperties.Name="切换置顶">
                                                    <FontIcon Glyph="&#xE718;" FontSize="13" />
                                                </ToggleButton>
                                                <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="Delete_Click"
                                                        ToolTipService.ToolTip="删除" AutomationProperties.Name="删除记录">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="5" Margin="2,9,2,0">
                        <TextBlock Text="单击复制" Style="{StaticResource HuahaiSecondaryTextStyle}" />
                        <TextBlock Text="双击粘贴 · Enter" HorizontalAlignment="Right"
                                   Style="{StaticResource HuahaiSecondaryTextStyle}" />
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsPane" Visibility="Collapsed" Background="#F4211E24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SettingsDragRegion" Padding="17,0" PointerPressed="DragRegion_PointerPressed"
                          BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource HuahaiIconButtonStyle}" Click="BackFromSettings_Click"
                                ToolTipService.ToolTip="返回面板" AutomationProperties.Name="返回面板">
                            <FontIcon Glyph="&#xE72B;" FontSize="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="设置" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource HuahaiTextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock x:Name="SaveStatusText" Grid.Column="2" Style="{StaticResource HuahaiSecondaryTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#7A361F3C" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Padding="14,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="7,0,0,18" Spacing="5">
                                    <TextBlock Text="花海" FontFamily="KaiTi" FontSize="21" FontWeight="Bold"
                                               Foreground="{StaticResource HuahaiAccentBrush}" />
                                    <TextBlock Text="剪贴板" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <ListView x:Name="SettingsNavigation" SelectionMode="Single"
                                          SelectionChanged="SettingsNavigation_SelectionChanged"
                                          ItemContainerStyle="{StaticResource HuahaiSettingsNavStyle}">
                                    <ListViewItem Tag="Appearance" Content="外观与主题" />
                                    <ListViewItem Tag="Motion" Content="动效" />
                                    <ListViewItem Tag="Input" Content="唤出与隐私" />
                                    <ListViewItem Tag="Storage" Content="本机存储" />
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1" Margin="30,24,30,24">
                            <ScrollViewer x:Name="AppearanceSettingsPage" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="18">
                                    <StackPanel>
                                        <TextBlock Text="外观与主题" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="调整皮肤与液态玻璃材质，修改会即时保存。"
                                                   Style="{StaticResource HuahaiSecondaryTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Height="1" Background="#24FFFFFF" />
                                    <TextBlock Text="主题皮肤" FontSize="14" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Tag="rose-purple" Click="ThemeButton_Click" Padding="8" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="7"><Border Height="48" CornerRadius="7" Background="#A85F7CAA" /><TextBlock Text="玫瑰紫" HorizontalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Tag="cobalt-blue" Click="ThemeButton_Click" Padding="8" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="7"><Border Height="48" CornerRadius="7" Background="#A83466A7" /><TextBlock Text="钴蓝" HorizontalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Tag="emerald-cyan" Click="ThemeButton_Click" Padding="8" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="7"><Border Height="48" CornerRadius="7" Background="#A8318579" /><TextBlock Text="翡翠青" HorizontalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Tag="amber-orange" Click="ThemeButton_Click" Padding="8" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="7"><Border Height="48" CornerRadius="7" Background="#A89A654C" /><TextBlock Text="琥珀橙" HorizontalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Tag="aurora-cyan-purple" Click="ThemeButton_Click" Padding="8" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="7"><Border Height="48" CornerRadius="7" Background="#A84E6B91" /><TextBlock Text="极光" HorizontalAlignment="Center" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="玻璃材质" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <Grid MinHeight="54">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="透明度" />
                                            <TextBlock Text="控制桌面背景透过程度" Style="{StaticResource HuahaiSecondaryTextStyle}" />
                                        </StackPanel>
                                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.65" Maximum="0.96" Value="0.86"
                                                VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="MotionSettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="18">
                                    <StackPanel>
                                        <TextBlock Text="动效" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="控制花瓣背景、液态反光与点击反馈。" Style="{StaticResource HuahaiSecondaryTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Height="1" Background="#24FFFFFF" />
                                    <CheckBox x:Name="PetalCheckBox" Content="显示背景层花瓣" IsChecked="True"
                                              Checked="PetalCheckBox_Changed" Unchecked="PetalCheckBox_Changed" />
                                    <CheckBox x:Name="ReduceMotionCheckBox" Content="减少动态效果"
                                              Checked="ReduceMotionCheckBox_Changed" Unchecked="ReduceMotionCheckBox_Changed" />
                                    <TextBlock Text="关闭动态后，点击反馈仍保留 120ms 的简短确认，然后才复制并隐藏面板。"
                                               Style="{StaticResource HuahaiSecondaryTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="InputSettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <StackPanel>
                                        <TextBlock Text="唤出与隐私" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="设置后台唤出方式和不记录剪贴板的应用。" Style="{StaticResource HuahaiSecondaryTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Height="1" Background="#24FFFFFF" />
                                    <CheckBox x:Name="RightDoubleClickCheckBox" Content="鼠标右键双击，在指针位置唤出"
                                              Checked="InputCheckBox_Changed" Unchecked="InputCheckBox_Changed" />
                                    <CheckBox x:Name="HotkeyCheckBox" Content="Ctrl+Shift+V 全局唤出"
                                              Checked="InputCheckBox_Changed" Unchecked="InputCheckBox_Changed" />
                                    <TextBlock Text="应用排除列表（每行一个 exe）" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" />
                                    <TextBlock Text="排除应用中的复制内容不会进入历史，右键双击也保留给原应用。"
                                               Style="{StaticResource HuahaiSecondaryTextStyle}" TextWrapping="Wrap" />
                                    <TextBox x:Name="ExcludedAppsTextBox" MinHeight="118" AcceptsReturn="True" TextWrapping="Wrap"
                                             PlaceholderText="例如：1Password.exe" LostFocus="ExcludedAppsTextBox_LostFocus" />
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="StorageSettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <StackPanel>
                                        <TextBlock Text="本机存储" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="数据仅保存在当前 Windows 用户目录，不登录账号。"
                                                   Style="{StaticResource HuahaiSecondaryTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Height="1" Background="#24FFFFFF" />
                                    <TextBlock Text="数据目录" FontSize="14" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DataPathTextBox" IsReadOnly="True" />
                                        <Button Grid.Column="1" Content="打开目录" Click="OpenDataDirectory_Click" />
                                    </Grid>
                                    <Border Padding="15" CornerRadius="10" Background="#50351D3E" BorderBrush="#34E0B1D9" BorderThickness="1">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="history.dat · 剪贴板历史（当前用户 DPAPI 加密）" TextWrapping="Wrap" />
                                            <TextBlock Text="settings.json · 皮肤、动效、快捷键和排除列表" TextWrapping="Wrap" />
                                            <TextBlock Text="images · 当前用户加密的图片剪贴板缓存" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
