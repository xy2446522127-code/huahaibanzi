<Window x:Class="HuahaiClipboard.NativeUiSpike.Presentation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="花海剪贴板"
        Width="430"
        Height="680"
        MinWidth="430"
        MinHeight="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="GlassRoot"
            CornerRadius="{DynamicResource HuahaiPanelCornerRadius}"
            Background="{DynamicResource HuahaiGlassBrush}"
            ClipToBounds="True">
        <Grid>
            <ContentControl x:Name="PanelHost" />
            <ContentControl x:Name="SettingsHost" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
