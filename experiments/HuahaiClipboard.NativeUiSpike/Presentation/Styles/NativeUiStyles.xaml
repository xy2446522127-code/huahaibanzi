<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:HuahaiClipboard.NativeUiSpike.Presentation.Controls">
    <BooleanToVisibilityConverter x:Key="HuahaiBoolVisibility" />

    <SolidColorBrush x:Key="HuahaiPanelOverlayBrush" Color="#6B230E29" />
    <SolidColorBrush x:Key="HuahaiInputBrush" Color="#94301A35" />
    <SolidColorBrush x:Key="HuahaiRecordBrush" Color="#88311A36" />
    <SolidColorBrush x:Key="HuahaiRecordHoverBrush" Color="#A1523154" />
    <SolidColorBrush x:Key="HuahaiHairlineBrush" Color="#3FD786BB" />
    <SolidColorBrush x:Key="HuahaiQuietBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="HuahaiDangerBrush" Color="#FFFFC5D3" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiTextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="HuahaiGlassButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="39" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource HuahaiInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HuahaiHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" />
                        <Border x:Name="SpecularLens"
                                Margin="1"
                                CornerRadius="10"
                                IsHitTestVisible="False"
                                Opacity="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:SpecularButtonBehavior.Intensity)}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#00FFFFFF" />
                                    <GradientStop Offset="0.42" Color="#44FFFFFF" />
                                    <GradientStop Offset="0.55" Color="#A4FFFFFF" />
                                    <GradientStop Offset="0.69" Color="#25FFFFFF" />
                                    <GradientStop Offset="1" Color="#00FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#A85E375F" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HuahaiIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="HuahaiFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiMutedTextBrush}" />
        <Setter Property="Background" Value="#52311B36" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="HuahaiRowActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1.5,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFD9C7D6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="HuahaiNavButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Height" Value="37" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="#FFCABCCA" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="HuahaiSpecButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#D31F1922" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="HuahaiTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="39" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HuahaiAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource HuahaiInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HuahaiHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HuahaiScrollThumbStyle" TargetType="Thumb">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="#88D786BB" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome"
                            Margin="1,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="#FFF0ADD6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HuahaiScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HuahaiScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="7" />
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="7" Background="Transparent">
                        <Border Width="3"
                                Margin="0,2"
                                HorizontalAlignment="Center"
                                Background="#183F243E"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource HuahaiScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HuahaiScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource HuahaiScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource HuahaiScrollBarStyle}" />

    <Style x:Key="HuahaiListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="HuahaiListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
