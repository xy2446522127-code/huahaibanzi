<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="HuahaiBoolVisibility" />

    <SolidColorBrush x:Key="HuahaiPanelOverlayBrush" Color="#6B230E29" />
    <SolidColorBrush x:Key="HuahaiInputBrush" Color="#94301A35" />
    <SolidColorBrush x:Key="HuahaiRecordBrush" Color="#88311A36" />
    <SolidColorBrush x:Key="HuahaiRecordHoverBrush" Color="#A1523154" />
    <SolidColorBrush x:Key="HuahaiHairlineBrush" Color="#3FD786BB" />
    <SolidColorBrush x:Key="HuahaiQuietBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="HuahaiDangerBrush" Color="#FFFFC5D3" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiTextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="HuahaiGlassButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="39" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource HuahaiInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HuahaiHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#A85E375F" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="Chrome" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HuahaiIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="HuahaiFilterButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiMutedTextBrush}" />
        <Setter Property="Background" Value="#52311B36" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="HuahaiRowActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1.5,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFD9C7D6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="HuahaiNavButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Height" Value="37" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="#FFCABCCA" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="HuahaiSpecButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HuahaiGlassButtonStyle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#D31F1922" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="HuahaiTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="39" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource HuahaiTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource HuahaiAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource HuahaiInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HuahaiHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HuahaiAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HuahaiListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="HuahaiListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
