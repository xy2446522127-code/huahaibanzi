<UserControl x:Class="HuahaiClipboard.NativeUiSpike.Presentation.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HuahaiClipboard.NativeUiSpike.Presentation.Controls"
             Background="Transparent">
    <Grid Margin="17,18,17,13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid MinHeight="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="31"
                        Height="31"
                        Background="#B8231226"
                        ClipToBounds="True"
                        CornerRadius="9">
                    <Image Source="/HuahaiClipboard.NativeUiSpike;component/Assets/fox-icon-source.png"
                           Stretch="UniformToFill" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="STKaiti, KaiTi, Microsoft YaHei UI"
                           FontSize="22"
                           FontStyle="Italic"
                           FontWeight="Bold">
                    <Run Foreground="#FFF0ADD6" Text="花海" /><Run Text="剪贴板" />
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource HuahaiMutedTextBrush}"
                       Text="{Binding HeaderSummary}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <TextBox x:Name="SearchBox"
                         Padding="35,0,12,0"
                         Style="{StaticResource HuahaiTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="35,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#FFD0BBCB"
                           IsHitTestVisible="False"
                           FontSize="12"
                           Text="搜索文本、链接、图片或文件">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="12,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="#FFD7BFD2"
                           IsHitTestVisible="False"
                           Text="&#xE721;" />
            </Grid>
            <Button Grid.Column="1"
                    Click="MinimizeButton_Click"
                    Content="−"
                    FontFamily="Segoe UI Symbol"
                    Style="{StaticResource HuahaiIconButtonStyle}"
                    ToolTip="隐藏到后台" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Click="SettingsButton_Click"
                    Content="⚙"
                    FontFamily="Segoe UI Symbol"
                    Style="{StaticResource HuahaiIconButtonStyle}"
                    ToolTip="设置" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Padding="0,0,0,7"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AllFilter" Click="FilterButton_Click" Content="全部" Tag="All" Style="{StaticResource HuahaiFilterButtonStyle}" />
                <Button Click="FilterButton_Click" Content="文本" Tag="Text" Style="{StaticResource HuahaiFilterButtonStyle}" />
                <Button Click="FilterButton_Click" Content="链接" Tag="Link" Style="{StaticResource HuahaiFilterButtonStyle}" />
                <Button Click="FilterButton_Click" Content="图片" Tag="Image" Style="{StaticResource HuahaiFilterButtonStyle}" />
                <Button Click="FilterButton_Click" Content="文件" Tag="File" Style="{StaticResource HuahaiFilterButtonStyle}" />
                <Button Click="FilterButton_Click" Content="收藏" Tag="Favorites" Style="{StaticResource HuahaiFilterButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <ListBox ItemsSource="{Binding VisibleItems}"
                     ItemContainerStyle="{StaticResource HuahaiListBoxItemStyle}"
                     ScrollViewer.CanContentScroll="True"
                     Style="{StaticResource HuahaiListBoxStyle}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ClipboardRecordView CopyRequested="Record_CopyRequested"
                                                      DeleteRequested="Record_DeleteRequested"
                                                      FavoriteRequested="Record_FavoriteRequested"
                                                      PinRequested="Record_PinRequested" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource HuahaiMutedTextBrush}"
                       Text="没有匹配的记录">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VisibleItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource HuahaiMutedTextBrush}"
                       Text="单击复制 · 自动隐藏" />
            <CheckBox x:Name="AutoHideCheckBox"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Content="自动隐藏"
                      Foreground="{DynamicResource HuahaiMutedTextBrush}"
                      FontSize="10"
                      IsChecked="True" />
        </Grid>

        <Border x:Name="ToastChrome"
                Grid.Row="0"
                Grid.RowSpan="5"
                MaxWidth="360"
                Margin="0,0,0,22"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#EE1D151F"
                BorderBrush="{DynamicResource HuahaiAccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastText" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
