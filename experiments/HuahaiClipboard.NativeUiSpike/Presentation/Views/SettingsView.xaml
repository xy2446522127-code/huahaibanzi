<UserControl x:Class="HuahaiClipboard.NativeUiSpike.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Root_PreviewKeyDown"
             PreviewMouseDown="Root_PreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,17" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HuahaiMutedTextBrush}" />
        </Style>
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="39" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#FF5C505E" CornerRadius="11">
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="#FFEEE5EC" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource HuahaiAccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeButtonStyle" TargetType="Button" BasedOn="{StaticResource HuahaiGlassButtonStyle}">
            <Setter Property="Height" Value="67" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#A41C111F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="12,17" Background="#92613A66" BorderBrush="#25D786BB" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,17">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="35" Height="35" Background="#B8231226" ClipToBounds="True" CornerRadius="10">
                            <Image Source="/HuahaiClipboard.NativeUiSpike;component/Assets/fox-icon-source.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="STKaiti, KaiTi, Microsoft YaHei UI" FontSize="17" FontStyle="Italic" FontWeight="Bold">
                                <Run Foreground="#FFF0ADD6" Text="花海" /><Run Text="剪贴板" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource HuahaiMutedTextBrush}" Text="本机隐私模式" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="AppearanceNav" Click="NavButton_Click" Content="◈  外观与主题" Tag="Appearance" Style="{StaticResource HuahaiNavButtonStyle}" />
                    <Button Click="NavButton_Click" Content="◌  动效" Tag="Motion" Style="{StaticResource HuahaiNavButtonStyle}" />
                    <Button Click="NavButton_Click" Content="⌁  唤出与隐私" Tag="Input" Style="{StaticResource HuahaiNavButtonStyle}" />
                    <Button Click="NavButton_Click" Content="▤  本机存储" Tag="Storage" Style="{StaticResource HuahaiNavButtonStyle}" />
                    <Button Click="NavButton_Click" Content="⚙  系统" Tag="System" Style="{StaticResource HuahaiNavButtonStyle}" />
                    <Button Click="NavButton_Click" Content="ⓘ  关于与更新" Tag="About" Style="{StaticResource HuahaiNavButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#B81E1B21">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="27,23,27,18">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="SemiBold" Text="外观与主题" />
                    <TextBlock x:Name="PageSubtitle" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource HuahaiMutedTextBrush}" Text="更改会立即应用到当前面板。" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Click="BackButton_Click" Content="←" FontFamily="Segoe UI Symbol" Style="{StaticResource HuahaiIconButtonStyle}" ToolTip="返回" />
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="27,0,20,22" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="AppearancePage">
                        <Border Padding="0,0,0,17">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,11" FontSize="13" FontWeight="SemiBold" Text="主题皮肤" />
                                <UniformGrid Columns="5">
                                    <Button x:Name="RoseTheme" Click="ThemeButton_Click" Tag="rose-purple" Style="{StaticResource ThemeButtonStyle}">
                                        <StackPanel><Border Height="39" CornerRadius="6"><Border.Background><RadialGradientBrush Center="0.25,0.22" GradientOrigin="0.25,0.22" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#FFEFAED8" /><GradientStop Offset="1" Color="#FF633A72" /></RadialGradientBrush></Border.Background></Border><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Text="玫瑰紫" /></StackPanel>
                                    </Button>
                                    <Button Click="ThemeButton_Click" Tag="cobalt-blue" Style="{StaticResource ThemeButtonStyle}">
                                        <StackPanel><Border Height="39" Background="#FF355A9D" CornerRadius="6" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Text="钴蓝" /></StackPanel>
                                    </Button>
                                    <Button Click="ThemeButton_Click" Tag="emerald-cyan" Style="{StaticResource ThemeButtonStyle}">
                                        <StackPanel><Border Height="39" Background="#FF2D7267" CornerRadius="6" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Text="翡翠青" /></StackPanel>
                                    </Button>
                                    <Button Click="ThemeButton_Click" Tag="amber-orange" Style="{StaticResource ThemeButtonStyle}">
                                        <StackPanel><Border Height="39" Background="#FF8A5945" CornerRadius="6" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Text="琥珀橙" /></StackPanel>
                                    </Button>
                                    <Button Click="ThemeButton_Click" Tag="aurora-cyan-purple" Style="{StaticResource ThemeButtonStyle}">
                                        <StackPanel><Border Height="39" CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF72D5E8" /><GradientStop Offset="1" Color="#FF8B72CF" /></LinearGradientBrush></Border.Background></Border><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Text="极光青紫" /></StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionStyle}">
                            <Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="背景透明度" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="直接改变面板透明程度" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Slider x:Name="OpacitySlider" Width="170" Minimum="65" Maximum="96" Value="74" ValueChanged="OpacitySlider_ValueChanged" /><TextBlock x:Name="OpacityValue" Width="38" Margin="8,0,0,0" VerticalAlignment="Center" Text="74%" /></StackPanel></Grid>
                        </Border>
                        <Border Style="{StaticResource SectionStyle}">
                            <Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="面板等比例缩放" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="字体、图标、间距和圆角同步缩放，不改变形状" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Slider x:Name="ScaleSlider" Width="150" Minimum="80" Maximum="160" TickFrequency="5" Value="100" ValueChanged="ScaleSlider_ValueChanged" /><TextBlock x:Name="ScaleValue" Width="42" Margin="8,0" VerticalAlignment="Center" Text="100%" /><Button Click="ResetScale_Click" Content="重置" Style="{StaticResource HuahaiSpecButtonStyle}" MinWidth="68" /></StackPanel></Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="MotionPage" Visibility="Collapsed">
                        <Border Padding="0,0,0,17"><StackPanel><Grid Margin="0,0,0,18"><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="背景层花瓣" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="隐藏面板时自动暂停" /></StackPanel><ToggleButton x:Name="PetalToggle" HorizontalAlignment="Right" IsChecked="True" Click="Toggle_Click" Style="{StaticResource ToggleStyle}" Tag="背景层花瓣" /></Grid><Grid Margin="0,0,0,18"><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="减少动态效果" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="停止流动反光与花瓣运动" /></StackPanel><ToggleButton x:Name="ReducedMotionToggle" HorizontalAlignment="Right" Click="Toggle_Click" Style="{StaticResource ToggleStyle}" Tag="减少动态效果" /></Grid><Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="点击反馈时长" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="复制成功后立即隐藏；此项控制其他按钮反馈" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Slider x:Name="DurationSlider" Width="170" Minimum="180" Maximum="900" Value="620" ValueChanged="DurationSlider_ValueChanged" /><TextBlock x:Name="DurationValue" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" Text="620ms" /></StackPanel></Grid></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="InputPage" Visibility="Collapsed">
                        <Border Padding="0,0,0,17"><Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="右键双击唤出" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="默认方式，可与自定义方式并存" /></StackPanel><ToggleButton x:Name="RightDoubleToggle" HorizontalAlignment="Right" IsChecked="True" Click="Toggle_Click" Style="{StaticResource ToggleStyle}" Tag="右键双击唤出" /></Grid></Border>
                        <Border Style="{StaticResource SectionStyle}"><StackPanel><TextBlock Margin="0,0,0,11" Style="{StaticResource SettingTitleStyle}" Text="自定义快捷唤出" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="CaptureShortcutButton" Click="CaptureShortcut_Click" Content="点击后自定义快捷唤出　　未设置" HorizontalContentAlignment="Left" Style="{StaticResource HuahaiGlassButtonStyle}" /><Button Grid.Column="1" Margin="8,0,0,0" Click="ResetShortcut_Click" Content="恢复默认" Style="{StaticResource HuahaiSpecButtonStyle}" /></Grid></StackPanel></Border>
                        <Border Style="{StaticResource SectionStyle}"><StackPanel><TextBlock Margin="0,0,0,11" Style="{StaticResource SettingTitleStyle}" Text="应用排除列表" /><TextBox x:Name="ExclusionTextBox" Height="80" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Style="{StaticResource HuahaiTextBoxStyle}" ToolTip="每行输入一个应用，例如 1Password.exe" /><Button Width="120" Margin="0,8,0,0" HorizontalAlignment="Left" Click="SaveExclusions_Click" Content="保存排除列表" Style="{StaticResource HuahaiSpecButtonStyle}" /></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="StoragePage" Visibility="Collapsed">
                        <Border Padding="0,0,0,17"><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="数据保存位置" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="历史记录使用当前 Windows 用户加密" /><Border Margin="0,10,0,8" Padding="10,9" Background="#20FFFFFF" CornerRadius="9"><TextBlock x:Name="DataPathText" FontSize="10" Foreground="{DynamicResource HuahaiMutedTextBrush}" /></Border><Button Width="104" HorizontalAlignment="Left" Click="OpenFolder_Click" Content="打开目录" Style="{StaticResource HuahaiSpecButtonStyle}" /></StackPanel></Border>
                        <Border Style="{StaticResource SectionStyle}"><Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="自动清理普通历史" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="到期仅删除普通记录；收藏和置顶始终保留" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Click="Retention_Click" Content="3 天" Tag="3" Style="{StaticResource HuahaiGlassButtonStyle}" Height="32" /><Button Margin="6,0" Click="Retention_Click" Content="7 天" Tag="7" Style="{StaticResource HuahaiGlassButtonStyle}" Height="32" /><Button Click="Retention_Click" Content="1 个月" Tag="30" Style="{StaticResource HuahaiGlassButtonStyle}" Height="32" /></StackPanel></Grid></Border>
                        <Border Style="{StaticResource SectionStyle}"><StackPanel><Grid Margin="0,0,0,12"><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="清空普通历史" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="立即删除普通记录，保留收藏和置顶" /></StackPanel><Button HorizontalAlignment="Right" Click="ClearOrdinary_Click" Content="清空普通历史" Style="{StaticResource HuahaiSpecButtonStyle}" /></Grid><Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="清空全部内容" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="包括收藏和置顶，需再次确认" /></StackPanel><Button x:Name="ClearAllButton" HorizontalAlignment="Right" Click="ClearAll_Click" Content="清空全部" Foreground="{StaticResource HuahaiDangerBrush}" Style="{StaticResource HuahaiSpecButtonStyle}" /></Grid></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                        <Border Padding="0,0,0,17"><StackPanel><Grid Margin="0,0,0,18"><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="开机自动运行" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="登录 Windows 后在后台启动，不弹出面板" /></StackPanel><ToggleButton x:Name="StartupToggle" HorizontalAlignment="Right" Click="Toggle_Click" Style="{StaticResource ToggleStyle}" Tag="开机自动运行" /></Grid><Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="后台运行" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="关闭面板后保留托盘与唤出监听" /></StackPanel><ToggleButton x:Name="BackgroundToggle" HorizontalAlignment="Right" IsChecked="True" Click="Toggle_Click" Style="{StaticResource ToggleStyle}" Tag="后台运行" /></Grid></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <Border Padding="16" Background="#20FFFFFF" BorderBrush="{DynamicResource HuahaiHairlineBrush}" BorderThickness="1" CornerRadius="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="58" Height="58" ClipToBounds="True" CornerRadius="16"><Image Source="/HuahaiClipboard.NativeUiSpike;component/Assets/fox-icon-source.png" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" Margin="15,0,0,0"><TextBlock FontSize="18" FontWeight="SemiBold" Text="花海剪贴板" /><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource HuahaiMutedTextBrush}" Text="原生低内存正式版 · Windows 10 / 11&#x0a;所有历史和设置仅保存在本机。" /><Border Width="104" Margin="0,8,0,0" Padding="7,4" HorizontalAlignment="Left" Background="#24D886BB" CornerRadius="10"><TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#FFF0BDDC" Text="本机隐私模式" /></Border></StackPanel></Grid></Border>
                        <Border Style="{StaticResource SectionStyle}"><StackPanel><Grid><StackPanel><TextBlock Style="{StaticResource SettingTitleStyle}" Text="启动时检查更新" /><TextBlock Style="{StaticResource SettingDescriptionStyle}" Text="仅检查 GitHub Release 并提醒，不静默安装" /></StackPanel><ToggleButton x:Name="UpdateToggle" HorizontalAlignment="Right" IsChecked="True" Click="Toggle_Click" Style="{StaticResource ToggleStyle}" Tag="启动时检查更新" /></Grid><Border Margin="0,11,0,0" Padding="12,11" Background="#58151018" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10"><TextBlock x:Name="UpdateStatus" FontSize="11" Text="尚未检查更新。" /></Border><StackPanel Margin="0,12,0,0" Orientation="Horizontal"><Button Click="CheckUpdate_Click" Content="检查更新" Style="{StaticResource HuahaiSpecButtonStyle}" /><Button Margin="8,0,0,0" Click="Release_Click" Content="查看 GitHub Release" Style="{StaticResource HuahaiSpecButtonStyle}" /></StackPanel></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border x:Name="ToastChrome" Grid.RowSpan="2" MaxWidth="420" Margin="0,0,0,22" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#EE1D151F" BorderBrush="{DynamicResource HuahaiAccentBrush}" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" FontSize="11" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
